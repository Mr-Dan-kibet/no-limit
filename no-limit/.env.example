# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Service role key. Used ONLY by `npm run seed:user` to create your account.
# Bypasses RLS — never prefix it with NEXT_PUBLIC_, never commit it, never
# deploy it to Vercel (the app itself does not read this at runtime).
SUPABASE_SERVICE_ROLE_KEY=<service role key>
